# Salin file ini menjadi .env lalu ganti semua nilai GANTI_...
# File .env TIDAK boleh di-push ke GitHub (sudah ada di .gitignore).

# ---------- database: satu password per peran (RBAC) ----------
POSTGRES_ADMIN_PASSWORD=GANTI_password_admin
ENGINEER_PASSWORD=GANTI_password_engineer
ANALYST_PASSWORD=GANTI_password_analyst
VIEWER_PASSWORD=GANTI_password_viewer

# ---------- backup terenkripsi ----------
# Buat kunci sekali saja, lalu tempel hasilnya di sini:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Simpan kunci ini di tempat aman: tanpa kunci, file backup tidak bisa dipulihkan.
BACKUP_ENCRYPTION_KEY=GANTI_kunci_fernet

# ---------- object storage (MinIO) ----------
MINIO_ROOT_USER=vistaland
MINIO_ROOT_PASSWORD=GANTI_password_minio_min_8_karakter
# dipakai kalau ETL dijalankan manual dari laptop (di container otomatis minio:9000)
MINIO_ENDPOINT=localhost:9000

# ---------- email notifikasi (Mailpit lokal) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_DATA_ENGINEER=data.engineer@vistaland.local
EMAIL_DBA=dba@vistaland.local
EMAIL_DATA_STEWARD=data.steward@vistaland.local

# ---------- lain-lain ----------
# jeda retry Airflow (menit). Untuk demo kegagalan bisa diubah ke 1.
RETRY_DELAY_MINUTES=10
